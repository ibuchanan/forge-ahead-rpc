{
  "name": "forge-ahead-rpc",
  "version": "0.1.0",
  "private": true,
  "description": "JSON-RPC dispatch and webtrigger transport for Atlassian Forge",
  "license": "Apache-2.0",
  "author": "ibuchanan",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webtrigger": {
      "import": {
        "types": "./dist/webtrigger.d.ts",
        "default": "./dist/webtrigger.mjs"
      },
      "require": {
        "types": "./dist/webtrigger.d.cts",
        "default": "./dist/webtrigger.cjs"
      }
    },
    "./generator": {
      "import": {
        "types": "./dist/generator.d.ts",
        "default": "./dist/generator.mjs"
      },
      "require": {
        "types": "./dist/generator.d.cts",
        "default": "./dist/generator.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh scripts/build.sh",
    "build:development": "tsdown --config tsdown.development.config.json --no-dts",
    "test:profiles": "RPC_CHECK_BUILDS=1 bun test tests/development-profile.test.ts",
    "changelog": "git cliff --config cliff.toml --unreleased -o CHANGELOG.md",
    "check": "bun run build && bun run build:development && RPC_CHECK_BUILDS=1 bun run lint && bun run pack:check",
    "clean": "rm -rf node_modules package-lock.json dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "bun run test:coverage && bun run coverage:convert && run-p --npm-path bun --print-label \"lint:check:*\"",
    "lint:check:biome": "biome lint",
    "lint:check:fallow": "FALLOW_TELEMETRY=off fallow --summary",
    "lint:check:format": "biome format",
    "lint:check:typecheck": "tsc --project tsconfig.typecheck.json --noEmit",
    "lint:docs": "run-p --npm-path bun --print-label \"lint:docs:*\"",
    "lint:docs:markdown": "markdownlint-cli2 \"**/*.md\"",
    "lint:docs:spelling": "cspell lint \"**/*.md\"",
    "lint:fix": "biome lint --write",
    "pack:check": "sh scripts/pack-check.sh",
    "prepare": "bun run build && (lefthook install || true)",
    "release": "bash scripts/release.sh",
    "release:check": "bun run check",
    "test": "bun test --pass-with-no-tests",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "coverage:convert": "bun run scripts/coverage.mjs",
    "test:watch": "bun test --watch --pass-with-no-tests",
    "todo": "git grep -n -I -F TO\"DO\" -- .; status=$?; if [ \"$status\" -eq 1 ]; then echo \"No TO\"\"DO markers found.\"; elif [ \"$status\" -ne 0 ]; then exit \"$status\"; fi",
    "typecheck": "tsc --project tsconfig.typecheck.json --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "@types/node": "22",
    "ajv": "^8.20",
    "cspell": "^10.4",
    "fallow": "^3.42",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "markdownlint-cli2": "^0.24",
    "npm-run-all2": "^9.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23",
    "typescript": "^5.9"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "json-rpc-2.0": "^1.8"
  },
  "trustedDependencies": [
    "@forge-ahead/errors"
  ]
}
